# ============================================================
# PathoEBM 模型与 API 配置文件
# 使用前请填入你的 API Key
# ============================================================

# ---- 模型提供方选择 ----
# 可选值: "local" | "deepseek" | "gpt"
# local    = 本地 vLLM 部署 (http://localhost:8000/v1)
# deepseek = DeepSeek API (api.deepseek.com)
# gpt      = OpenAI API (api.openai.com/v1)
[model]
provider = "deepseek"

# ---- DeepSeek API ----
[deepseek]
api_base = "https://api.deepseek.com"
api_key = "YOUR_DEEPSEEK_API_KEY_HERE"

# ---- OpenAI API (GPT-4.1 等) ----
[openai]
api_base = "https://api.openai.com/v1"
api_key = "EMPTY_KEY"

# ---- Embedding 服务 ----
[embedding]
api_key = "EMPTY_KEY"
cache = "embedding_cache.pkl"

# ---- MCP 工具服务器 ----
[mcp]
server_url = "http://localhost:8788"

# ---- 模板 Embedding (可选) ----
[template]
api_base = ""
api_key = "EMPTY_KEY"
